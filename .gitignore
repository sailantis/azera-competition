/vendor/
/temp/
/writable/
/data/aop/
/data/cache/
/data/bench.sqlite
/data/bench.sqlite-journal
/data/bench.sqlite-wal
/data/bench.sqlite-shm

# Spiral kernel runtime dir (tokenizer listener cache)
/runtime/

# Per-app compiled template caches
apps/**/cache/
# ...except CI4's in-memory cache handler class (a real source file, not a runtime cache dir)
!apps/codeigniter/Cache/
!apps/codeigniter/Cache/*.php
apps/**/storage/
apps/**/writable/
apps/**/tmp/

# Results (keep committed baselines if desired; ignore transient runs)
results/transient/

# Bench-harness scratch. The root-anchored `/temp/` above does not reach this,
# and this directory is scratch by definition: dump.php writes the rendered HTML
# here, run.php's --out=temp/... writes probe datasets here, and run-remote.ps1
# excludes `temp` from every VM sync for the same reason. Committing it would
# add ~50 KB of regenerated HTML to every diff.
benchmarks/view-engine/temp/

# Probe and smoke datasets. A run meant for publication writes a
# `<date>-<label>`-prefixed dataset; a probe or a local smoke run writes a
# throwaway one, and those were accumulating untracked. Named `view-engine-*`
# runs are NOT ignored here: a published dataset keeps its real name.
benchmarks/view-engine/*-smoke.*
benchmarks/view-engine/ve-probe-*
results/ve-probe-*
results/*-smoke.*
results/*-local-*
results/view-engine-*-r[0-9]-*
results/view-engine-*-r[0-9][0-9]-*

# OS / IDE
.idea/
.vscode/
*.swp
.DS_Store

# Composer
composer.phar
# Keep composer.lock for reproducible benchmark installs (this is an application)

# PHPUnit
.phpunit.cache/
.phpunit.result.cache
