/vendor/
/temp/
/writable/
/data/aop/
/data/cache/
/data/bench.sqlite
/data/bench.sqlite-journal
/data/bench.sqlite-wal
/data/bench.sqlite-shm

# Spiral kernel runtime dir (tokenizer listener cache)
/runtime/

# Per-app compiled template caches
apps/**/cache/
# ...except CI4's in-memory cache handler class (a real source file, not a runtime cache dir)
!apps/codeigniter/Cache/
!apps/codeigniter/Cache/*.php
apps/**/storage/
apps/**/writable/
apps/**/tmp/

# Results (keep committed baselines if desired; ignore transient runs)
results/transient/

# Only the datasets a VIEW reads belong in git. `scripts/report/views.php`
# declares exactly four, and everything else in results/ is one of two things:
#
#   * a SPLICE INPUT — the fresh run handed to scripts/merge-modes.php or
#     scripts/merge-app.php so a single app or mode can be folded into a
#     canonical dataset. Its numbers live on inside the target; the file itself
#     is then dead weight, and it reads like a dataset the report might use.
#   * a DATED SNAPSHOT of a superseded run (`quick-<sha>.json`,
#     `full-<date>.json`). Git already holds every historical version.
#
# Fifteen such files had accumulated (~1.6 MB) and none was read by any view,
# test or script. The four that ARE read stay whitelisted below, so anything
# new that appears here is a deliberate act rather than a `git add -A` away
# from being committed as if it were a measurement.
results/*
!results/free-for-all-opcache-iso.json
!results/free-for-all-opcache-iso-deployments.json
!results/real-deployments.json
!results/real-0.5.0.json

# The .csv/.md companions are DERIVED and are not committed: `run.php --export=
# results/<prefix>` re-emits both from the .json with the same writers the
# harness uses. They had been committed and had gone wrong in the two ways a
# derived artefact does — `real-deployments.csv/.md` still described the
# 2026-11-16 run (552 rows) beside a JSON from 2026-11-24 (728 rows), and all
# four had been rewritten as UTF-16LE by an earlier `>` redirection. A second
# copy of a dataset that can silently disagree with its source is worse than
# no copy.
results/*.csv
results/*.md

# Bench-harness scratch. The root-anchored `/temp/` above does not reach this,
# and this directory is scratch by definition: dump.php writes the rendered HTML
# here, run.php's --out=temp/... writes probe datasets here, and run-remote.ps1
# excludes `temp` from every VM sync for the same reason. Committing it would
# add ~50 KB of regenerated HTML to every diff.
benchmarks/view-engine/temp/

# Probe and smoke datasets. A run meant for publication writes a
# `<date>-<label>`-prefixed dataset; a probe or a local smoke run writes a
# throwaway one, and those were accumulating untracked. Named `view-engine-*`
# runs are NOT ignored here: a published dataset keeps its real name.
benchmarks/view-engine/*-smoke.*
benchmarks/view-engine/ve-probe-*
results/ve-probe-*
results/*-smoke.*
results/*-local-*
results/view-engine-*-r[0-9]-*
results/view-engine-*-r[0-9][0-9]-*

# -Quick smoke runs write results/smoke-<date>.json, which is the OPPOSITE order
# from the `*-smoke.*` patterns above; without this the file sat untracked after
# every smoke run and was one `git add -A` away from being committed as a dataset.
# Its rendered report is ignored alongside it.
results/smoke-*

# Manual pre-splice snapshots (`cp results/real-deployments.json
# results/real-deployments.pre-jit.json`) taken before scripts/merge-modes.php
# rewrites a dataset, and the fresh run fed into it. They are working copies of a
# file that is itself committed: `real-deployments.pre-volucer.json` was
# byte-identical to the `real-deployments.json` of its day, and the others sit in
# the same history. Recoverable from git, so they must not be added as datasets.
results/*.pre-*.json
results/cold-refresh.json

# Rendered reports of a fetched run. `run-remote.ps1 -Fetch` writes the dataset
# AND a `results/<name>-report/` tree beside it (scripts/report.php --out), which
# is the rendered form of a file that is itself on disk: one run produced 528
# such files, all reproducible with one command, and none of them a dataset.
# Without this rule they sat untracked after every fetch and were one
# `git add -A` away from being committed as if they were measurements.
results/*-report/

# OS / IDE
.idea/
.vscode/
*.swp
.DS_Store

# Composer
composer.phar
# Keep composer.lock for reproducible benchmark installs (this is an application)

# PHPUnit
.phpunit.cache/
.phpunit.result.cache
