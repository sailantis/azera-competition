{
  "name": "azera/competition",
  "description": "Azera Competition - PHP framework benchmarks.",
  "type": "application",
  "repositories": [
    {
      "type": "path",
      "url": "../clarity-engine"
    },
    {
      "type": "path",
      "url": "../azera-framework"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "sailantis/clarity-engine": "dev-main",
    "sailantis/azera-framework": "dev-main",
    "laravel/framework": "^12.0",
    "symfony/http-kernel": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/http-foundation": "^7.0",
    "symfony/event-dispatcher": "^7.0",
    "symfony/framework-bundle": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "doctrine/doctrine-bundle": "^2.0",
    "symfony/validator": "^7.0",
    "symfony/cache": "^7.0",
    "symfony/rate-limiter": "^7.0",
    "symfony/config": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/yaml": "^7.0",
    "symfony/filesystem": "^7.0",
    "symfony/twig-bridge": "^7.0",
    "symfony/doctrine-bridge": "^7.0",
    "twig/twig": "3.27",
    "league/plates": "^3.6",
    "doctrine/orm": "^3.0",
    "doctrine/dbal": "^4.0",
    "spiral/core": "^3.0",
    "spiral/http": "^3.0",
    "spiral/router": "^3.0",
    "spiral/views": "^3.0",
    "spiral/stempler-bridge": "^3.0",
    "spiral/cycle-bridge": "^2.9",
    "cycle/database": "^2.9",
    "cycle/orm": "^2.0",
    "codeigniter4/framework": "^4.5",
    "spiral/framework": "^3.17",
    "spiral/validator": "^1.8",
    "spiral-packages/league-event": "^1.0",
    "cakephp/cakephp": "5.4"
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "spiral/composer-publish-plugin": true
    }
  }
}
