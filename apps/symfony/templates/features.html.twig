{% extends 'base.html.twig' %}

{% block title %}Features{% endblock %}

{% block content %}
<h1>Enterprise Feature Demos</h1>

<p>
    These endpoints exercise Symfony's enterprise subsystems
    (interceptors, events, cache, validation, config)
    on a real Symfony app — without touching the production sailantis-homepage.
</p>

<table>
<thead>
    <tr>
        <th>Feature</th>
        <th>Description</th>
    </tr>
</thead>
<tbody>
    {% for feature in features %}
    <tr>
        <td>
            <a href="{{ feature.url }}">{{ feature.title }}</a>
        </td>
        <td>{{ feature.desc }}</td>
    </tr>
    {% endfor %}
</tbody>
</table>

<p class="meta">
    All endpoints return JSON for easy inspection. Click a link to try one.
</p>
{% endblock %}
