# nginx vhost for benchmark app {{APP}} — real FPM cold benchmark (port {{PORT}}).
# Serves the same public/index-{{APP}}.php router the built-in server uses.

server {
    listen 127.0.0.1:{{PORT}};
    server_name bench.local;

    root {{ROOT}}/public;
    index index-{{APP}}.php;

    location / {
        try_files $uri /index-{{APP}}.php$is_args$args;
    }

    location ~ ^/index-{{APP}}\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php-fpm-bench/{{APP}}.sock;
    }

    access_log off;
    error_log {{ROOT}}/temp/nginx-{{APP}}.log warn;
}